# Copy to `.env` and fill in. `.env` is gitignored — it never leaves your machine,
# never lands in the repo, the Docker image, or CI.
#
# Free providers (no credit card): groq, cerebras, openrouter, gemini, mistral, nvidia
# Local (no key needed): ollama, lmstudio
# See docs/free-llm-providers.md for per-provider signup instructions.
LLM_PROVIDER=groq
LLM_API_KEY=
# LLM_MODEL=
